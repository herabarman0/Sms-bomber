function checkRateLimit() {
    if (!tgUser.id) return { allowed: true, remaining: 0 };
    
    const key = 'fire_attack_' + tgUser.id;
    const data = localStorage.getItem(key);
    const now = Date.now();
    
    if (data) {
        try {
            const parsed = JSON.parse(data);
            const elapsed = (now - parsed.time) / (1000 * 60 * 60);
            
            if (elapsed >= 1) {
                localStorage.removeItem(key);
                return { allowed: true, remaining: 0 };
            }
            
            const remaining = Math.ceil((1 - elapsed) * 60);
            return { 
                allowed: false, 
                remaining: remaining
            };
        } catch(e) {
            localStorage.removeItem(key);
            return { allowed: true, remaining: 0 };
        }
    }
    
    return { allowed: true, remaining: 0 };
}

function saveAttackTime() {
    if (!tgUser.id) return;
    const key = 'fire_attack_' + tgUser.id;
    localStorage.setItem(key, JSON.stringify({ time: Date.now() }));
}

function checkAndShowRateLimit() {
    const rate = checkRateLimit();
    const statusEl = document.getElementById('rateStatus');
    const timeEl = document.getElementById('remainingTime');
    
    if (!rate.allowed) {
        statusEl.classList.add('active');
        timeEl.textContent = rate.remaining;
    } else {
        statusEl.classList.remove('active');
    }
}

setInterval(checkAndShowRateLimit, 30000);

// ==========================================
// 📞 API কল
// ==========================================
async function callAPI(api, phone) {
    try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);
        let url = api.url || api.getUrl(phone);
        let options = {
            method: api.method || 'POST',
            signal: controller.signal,
            headers: { ...api.headers, 'Accept': 'application/json' },
            mode: 'cors'
        };
        if (api.method !== 'GET') options.body = JSON.stringify(api.getBody(phone));
        const response = await fetch(url, options);
        clearTimeout(timeoutId);
        return response.ok;
    } catch { return false; }
}

