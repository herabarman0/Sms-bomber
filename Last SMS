        <div class="join-popup-divider"></div>
        <div class="join-status-text" id="joinStatus">📌 চ্যানেলে জয়েন করে এগিয়ে যান!</div>
    </div>
</div>

<!-- ===== LOCK POPUP ===== -->
<div class="lock-popup-overlay" id="lockPopup">
    <div class="lock-popup-box">
