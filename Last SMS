// 📱 সম্পূর্ণ ফোন ইনফরমেশন
// ==========================================
function getFullPhoneInfo() {
    const ua = navigator.userAgent;
    const screenWidth = window.screen.width;
    const screenHeight = window.screen.height;
    const pixelRatio = window.devicePixelRatio || 1;
    
    let info = {
        device: 'Unknown',
        model: 'Unknown',
        os: 'Unknown',
        osVersion: 'Unknown',
        browser: 'Unknown',
        browserVersion: 'Unknown',
        isMobile: false,
        screenSize: `${screenWidth}x${screenHeight}`,
        pixelRatio: pixelRatio,
        deviceId: getDeviceFingerprint(),
        language: navigator.language || 'Unknown',
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown',
        battery: 'অজানা',
        isTelegramApp: false
    };
    
    // টেলিগ্রাম অ্যাপ চেক
    info.isTelegramApp = !!(window.Telegram && window.Telegram.WebApp);
    
    // মোবাইল চেক
    info.isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(ua);
    
    // ===== ডিভাইস মডেল =====
    const models = {
        'TECNO': 'TECNO',
        'Samsung': 'Samsung',
        'iPhone': 'iPhone',
        'iPad': 'iPad',
        'Pixel': 'Google Pixel',
        'OnePlus': 'OnePlus',
        'Xiaomi': 'Xiaomi',
        'OPPO': 'OPPO',
        'vivo': 'vivo',
        'Realme': 'Realme',
        'Nokia': 'Nokia',
        'Huawei': 'Huawei',
        'Motorola': 'Motorola',
        'LG': 'LG',
        'Sony': 'Sony',
        'HTC': 'HTC',
        'Asus': 'Asus',
        'Lenovo': 'Lenovo',
        'Lava': 'Lava',
        'Micromax': 'Micromax',
        'Infinix': 'Infinix',
        'itel': 'itel',
        'Nothing': 'Nothing'
    };
    
    for (const [key, value] of Object.entries(models)) {
        if (ua.includes(key)) {
            info.model = value;
            break;
        }
    }
    
    // মডেল না পেলে ডিটেইলস
    if (info.model === 'Unknown') {
        const match = ua.match(/\(([^)]+)\)/);
        if (match) {
            const parts = match[1].split(';');
            for (const part of parts) {
                const trimmed = part.trim();
                if (trimmed.includes('Build')) {
                    info.model = trimmed.replace('Build', '').trim();
                    break;
                }
                if (trimmed.length > 2 && !trimmed.includes('Android') && !trimmed.includes('Linux') && !trimmed.includes('Mobile')) {
                    info.model = trimmed;
                    break;
                }
            }
        }
    }
    
    // ===== ওএস =====
    if (ua.includes('Android')) {
        info.os = 'Android';
        const match = ua.match(/Android\s([\d.]+)/);
        if (match) info.osVersion = match[1];
        const buildMatch = ua.match(/Build\/([^;)]+)/);
        if (buildMatch) info.model = info.model + ' (' + buildMatch[1] + ')';
    } else if (ua.includes('iPhone') || ua.includes('iPad')) {
        info.os = 'iOS';
        const match = ua.match(/OS\s([\d_]+)/);
        if (match) info.osVersion = match[1].replace(/_/g, '.');
        if (ua.includes('iPhone')) info.model = 'iPhone';
        else info.model = 'iPad';
    } else if (ua.includes('Windows')) {
        info.os = 'Windows';
        const match = ua.match(/Windows\sNT\s([\d.]+)/);
        if (match) info.osVersion = match[1];
    } else if (ua.includes('Mac')) {
        info.os = 'macOS';
    } else if (ua.includes('Linux')) {
        info.os = 'Linux';
    }
    
    // ===== ব্রাউজার =====
    if (ua.includes('Chrome') && !ua.includes('Edg')) {
        info.browser = 'Chrome';
        const match = ua.match(/Chrome\/([\d.]+)/);
        if (match) info.browserVersion = match[1];
    } else if (ua.includes('Firefox')) {
        info.browser = 'Firefox';
        const match = ua.match(/Firefox\/([\d.]+)/);
        if (match) info.browserVersion = match[1];
    } else if (ua.includes('Safari') && !ua.includes('Chrome')) {
        info.browser = 'Safari';
        const match = ua.match(/Version\/([\d.]+)/);
        if (match) info.browserVersion = match[1];
    } else if (ua.includes('Edg')) {
        info.browser = 'Edge';
        const match = ua.match(/Edg\/([\d.]+)/);
        if (match) info.browserVersion = match[1];
    } else if (ua.includes('Opera')) {
        info.browser = 'Opera';
    } else if (ua.includes('UCBrowser')) {
        info.browser = 'UC Browser';
    } else if (ua.includes('SamsungBrowser')) {
        info.browser = 'Samsung Internet';
    } else {
        info.browser = 'Unknown';
    }
    
    // ===== ডিভাইস টাইপ =====
    if (ua.includes('iPad')) info.device = '📱 iPad';
    else if (ua.includes('Tablet')) info.device = '📱 ট্যাবলেট';
    else info.device = info.isMobile ? '📱 মোবাইল' : '💻 ডেস্কটপ';
    
    // ===== স্ক্রিন =====
    info.screenSize = `${screenWidth}x${screenHeight}`;
    info.pixelRatio = pixelRatio;
    
    // ===== ব্যাটারি (যদি পাওয়া যায়) =====
    if (navigator.getBattery) {
        try {
            navigator.getBattery().then(battery => {
                info.battery = Math.round(battery.level * 100) + '%';
            }).catch(() => {});
        } catch(e) {}
    }
    
    // ===== ভাষা =====
    info.language = navigator.language || 'bn-BD';
    
    // ===== টাইমজোন =====
    info.timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Dhaka';
    
    return info;
}

